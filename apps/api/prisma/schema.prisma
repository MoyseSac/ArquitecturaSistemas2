datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // Lee de tu .env
}

generator client {
  provider = "prisma-client-js"
}


model Task {
  id          Int      @id @default(autoincrement()) // PK, se auto-incrementa
  title       String                                 // texto obligatorio
  description String?                                // texto opcional (el ? indica nullable)
  completed   Boolean  @default(false)               // false por defecto
  createdAt   DateTime @default(now())               // fecha automática al crear
  updatedAt   DateTime @updatedAt                    // se actualiza automáticamente
}